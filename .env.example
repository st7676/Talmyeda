VITE_API_URL=http://localhost:3000

# Public web URL where this same frontend is also hosted as a plain website
# (not the desktop app). Used to build the shareable /join?institution=<id>
# self-registration link shown in Settings — a file:// desktop app window
# has no browser-openable URL, so this can't be inferred automatically when
# built for Electron. Leave unset for local dev (falls back to the Vite dev
# server origin, which works fine for testing the join flow in a browser).
# VITE_PUBLIC_APP_URL=https://app.example.org
